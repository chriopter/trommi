app/web/public/demo/files/

# Rust build output.
/target/

# What a release built by hand writes (release files before they are signed and published).
/out/

# Python byte code (the iOS tools and their tests).
__pycache__/

# The Linux app (its own workspace): build output and the smoke test's picture.
/app/linux/target/
/app/linux/smoke.png
/app/linux/.qmlls.ini

# Local files that never belong in the repository: macOS folder data, environment files, agent settings.
.DS_Store
.env
.env.*
.claude/
