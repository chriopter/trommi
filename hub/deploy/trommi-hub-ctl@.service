# One request to trommi-hub-ctl.socket: hub-ctl.sh reads one word from the connection (start, stop, dryrun, restore),
# does that to the hub's fixed units and answers on one line. This is the only Trommi code that runs as root.
[Unit]
Description=Trommi hub start/stop helper (one request)
CollectMode=inactive-or-failed

[Service]
ExecStart=/bin/sh /usr/local/lib/trommi/hub-ctl.sh
StandardInput=socket
StandardOutput=socket
StandardError=journal
# a caller that says nothing does not keep it for long; a dry run takes at most 420 s (its unit)
RuntimeMaxSec=600
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
